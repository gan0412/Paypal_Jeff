# Anthropic API Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=INSERT_KEY

# Model identifier (Default: claude-3-5-haiku-latest)
# Options: claude-3-5-haiku-latest, claude-3-5-haiku-20241022, claude-3-haiku-20240307
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated or * for development)
CORS_ORIGINS=*
